# Optional settings. The application works without any of them.
# config.py reads real environment variables (it does not auto-load a .env file),
# so export them in your shell before starting the app, e.g.
#   Linux/macOS:  export LANGID_MAX_INPUT_CHARS=2000
#   Windows CMD:  set LANGID_MAX_INPUT_CHARS=2000
LANGID_MAX_INPUT_CHARS=5000
LANGID_SHORT_TEXT_LETTERS=15
LANGID_MIN_LETTERS=2
LANGID_MIN_CONFIDENCE=0.30
LANGID_API_HOST=127.0.0.1
LANGID_API_PORT=8000
